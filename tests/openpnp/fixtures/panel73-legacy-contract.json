{
  "scope": "Frozen Q72 full legacy structure tool and exact other tool definitions; source-only regression fixture.",
  "structure_tool": {
    "name": "openpnp_plan_placement_structure",
    "description": "Preview adding or removing real placements/fiducials on existing boards in a trusted unused simulator job. Returns an operation whose completed result binds a plan, exact lineage/revision and every affected instance. Requires disabled machine, empty nozzles, complete empty current/retired native history and no prior processor admission. New records require every placement field and an existing part/package. Native coordinates are local holder mm/in and degrees. Pseudo-dependent removal, panel structural edits, renaming and reused logical IDs are refused. Planning retains a receipt without publishing placements.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "expected_config_revision": {
          "type": "string",
          "pattern": "^cfg-[0-9]+$",
          "maxLength": 64
        },
        "job_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "expected_job_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "expected_board_load_revision": {
          "type": "string",
          "pattern": "^load-[0-9]+$",
          "maxLength": 64
        },
        "changes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "action": {
                    "const": "add"
                  },
                  "scope": {
                    "enum": [
                      "job_instance",
                      "job_shared_definition"
                    ]
                  },
                  "holder_instance_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048,
                    "pattern": "^[^\\u0000]+$"
                  },
                  "placement_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
                  },
                  "placement": {
                    "type": "object",
                    "properties": {
                      "location": {
                        "oneOf": [
                          {
                            "type": "object",
                            "properties": {
                              "frame": {
                                "const": "holder"
                              },
                              "units": {
                                "const": "mm"
                              },
                              "x": {
                                "type": "number",
                                "minimum": -10000,
                                "maximum": 10000
                              },
                              "y": {
                                "type": "number",
                                "minimum": -10000,
                                "maximum": 10000
                              },
                              "z": {
                                "type": "number",
                                "minimum": -1000,
                                "maximum": 1000
                              },
                              "rotation": {
                                "type": "number",
                                "minimum": -360,
                                "maximum": 360
                              }
                            },
                            "required": [
                              "frame",
                              "units",
                              "x",
                              "y",
                              "z",
                              "rotation"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "frame": {
                                "const": "holder"
                              },
                              "units": {
                                "const": "in"
                              },
                              "x": {
                                "type": "number",
                                "minimum": -393.7007874015748,
                                "maximum": 393.7007874015748
                              },
                              "y": {
                                "type": "number",
                                "minimum": -393.7007874015748,
                                "maximum": 393.7007874015748
                              },
                              "z": {
                                "type": "number",
                                "minimum": -39.37007874015748,
                                "maximum": 39.37007874015748
                              },
                              "rotation": {
                                "type": "number",
                                "minimum": -360,
                                "maximum": 360
                              }
                            },
                            "required": [
                              "frame",
                              "units",
                              "x",
                              "y",
                              "z",
                              "rotation"
                            ],
                            "additionalProperties": false
                          }
                        ]
                      },
                      "side": {
                        "enum": [
                          "Top",
                          "Bottom"
                        ]
                      },
                      "type": {
                        "enum": [
                          "Placement",
                          "Fiducial"
                        ]
                      },
                      "part_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "pattern": "^[^\\u0000]+$"
                      },
                      "enabled": {
                        "type": "boolean"
                      },
                      "error_handling": {
                        "enum": [
                          "Default",
                          "Alert",
                          "Defer"
                        ]
                      },
                      "comments": {
                        "type": "string",
                        "maxLength": 2048,
                        "pattern": "^[^\\u0000]*$"
                      },
                      "rank": {
                        "type": "integer",
                        "minimum": -100000,
                        "maximum": 100000
                      }
                    },
                    "required": [
                      "location",
                      "side",
                      "type",
                      "part_id",
                      "enabled",
                      "error_handling",
                      "comments",
                      "rank"
                    ],
                    "additionalProperties": false,
                    "minProperties": 1
                  }
                },
                "required": [
                  "action",
                  "scope",
                  "holder_instance_id",
                  "placement_id",
                  "placement"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "action": {
                    "const": "remove"
                  },
                  "scope": {
                    "enum": [
                      "job_instance",
                      "job_shared_definition"
                    ]
                  },
                  "holder_instance_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048,
                    "pattern": "^[^\\u0000]+$"
                  },
                  "placement_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[^⇒\\u0000]+$"
                  }
                },
                "required": [
                  "action",
                  "scope",
                  "holder_instance_id",
                  "placement_id"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": [
        "request_id",
        "session_id",
        "expected_config_revision",
        "job_id",
        "expected_job_revision",
        "expected_board_load_revision",
        "changes"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "title": "plan placement structure",
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false
    },
