+        // Snapshot on the notifying thread, before the native task can insert the next axis.
+        // Filtering uses the current EDT-owned axisType when this snapshot is displayed.
+        ArrayList<Axis> axes = new ArrayList<>(machine.getAxes());
+        Runnable update = () -> {
+            Collections.sort(axes, comparator);
+            ArrayList<String> names = new ArrayList<>();
+            for (Axis axis : axes) {
+                if (types.isInstance(axis) && (axisType == null || axisType == axis.getType()))
+                    names.add(axis.getName());
+            }
+            if (addEmpty) names.add("");
+            refreshElements(names);
+        };
+        if (SwingUtilities.isEventDispatchThread()) update.run();
+        else SwingUtilities.invokeLater(update);
+    }
+
+    // Keep retained selections in place: clearing the model would publish a transient null
+    // assignment to an open wizard's binding when another native device is merely added.
+    private void refreshElements(java.util.List<String> names) {
+        for (int i = getSize() - 1; i >= 0; i--) {
+            if (!names.contains(getElementAt(i))) removeElementAt(i);
+        }
+        for (int i = 0; i < names.size(); i++) {
+            if (i >= getSize() || !names.get(i).equals(getElementAt(i)))
+                insertElementAt(names.get(i), i);
+        }
+        while (getSize() > names.size()) removeElementAt(getSize() - 1);
+        if (getSelectedItem() == null && !names.isEmpty()) setSelectedItem(names.get(0));
     }
