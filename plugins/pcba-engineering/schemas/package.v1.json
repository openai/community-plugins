{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/pcba-engineering/package.v1.json",
  "title": "PCBA Engineering canonical assembly package v1",
  "type": "object",
  "required": ["schemaVersion", "board", "variant", "quantity", "conventions", "bom", "placements"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "board": {
      "type": "object", "required": ["id", "name", "revision", "widthMm", "heightMm"],
      "properties": {
        "id": { "$ref": "#/$defs/label" }, "name": { "$ref": "#/$defs/label" }, "revision": { "$ref": "#/$defs/label" },
        "widthMm": { "type": "number", "exclusiveMinimum": 0, "maximum": 10000 },
        "heightMm": { "type": "number", "exclusiveMinimum": 0, "maximum": 10000 }
      }, "additionalProperties": true
    },
    "variant": { "$ref": "#/$defs/label" },
    "quantity": { "type": "integer", "minimum": 1, "maximum": 1000000 },
    "conventions": {
      "type": "object", "required": ["units", "coordinateFrame", "rotation", "bottomView"],
      "properties": { "units": { "const": "mm" }, "coordinateFrame": { "const": "board-bottom-left" }, "rotation": { "const": "ccw" }, "bottomView": { "const": "top" } },
      "additionalProperties": true
    },
    "bom": { "type": "array", "minItems": 1, "maxItems": 100000, "items": { "$ref": "#/$defs/bomRow" } },
    "placements": { "type": "array", "maxItems": 100000, "items": { "$ref": "#/$defs/placement" } },
    "authoritativePlacements": { "type": "array", "maxItems": 100000, "items": { "$ref": "#/$defs/placement" } },
    "source": { "type": "object" }, "visual": { "type": "object" },
    "sourceFindings": {
      "type": "array", "maxItems": 100000,
      "items": {
        "type": "object", "required": ["id", "severity", "message"],
        "properties": {
          "id": { "$ref": "#/$defs/label" }, "severity": { "enum": ["warning", "error"] }, "message": { "type": "string", "minLength": 1, "maxLength": 8192 },
          "refs": { "type": "array", "maxItems": 100000, "items": { "$ref": "#/$defs/reference" } }
        }, "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "label": { "type": "string", "minLength": 1, "maxLength": 256 },
    "reference": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\s,;]+$" },
    "bomRow": {
      "type": "object", "required": ["ref", "partId", "value", "package", "category", "populated", "mpn"],
      "properties": {
        "ref": { "$ref": "#/$defs/reference" },
        "partId": { "type": "string", "maxLength": 8192 }, "value": { "type": "string", "maxLength": 8192 }, "package": { "type": "string", "maxLength": 8192 },
        "category": { "enum": ["smt", "tht", "mechanical", "fiducial"] }, "populated": { "type": "boolean" },
        "mpn": { "type": ["string", "null"], "maxLength": 8192 }
      }, "additionalProperties": true
    },
    "placement": {
      "type": "object", "required": ["ref", "xMm", "yMm", "rotationDeg", "side"],
      "properties": {
        "ref": { "$ref": "#/$defs/reference" }, "xMm": { "type": "number", "minimum": -1000000, "maximum": 1000000 }, "yMm": { "type": "number", "minimum": -1000000, "maximum": 1000000 },
        "rotationDeg": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 }, "side": { "enum": ["top", "bottom"] }, "package": { "type": "string", "maxLength": 8192 }
      }, "additionalProperties": true
    }
  }
}
