{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:devsecops:correction-contract:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "base_commit",
    "profile_sha256",
    "allowed_files",
    "allowed_rendered_changes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,62}$"
    },
    "base_commit": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "profile_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "allowed_files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "allowed_rendered_changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resource",
          "pointers"
        ],
        "properties": {
          "resource": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:/<>-]{1,1000}$"
          },
          "pointers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 2,
              "maxLength": 400
            }
          }
        }
      }
    }
  }
}
