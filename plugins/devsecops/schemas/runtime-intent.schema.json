{
  "$id": "urn:devsecops:runtime-intent:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "type": "string"
    },
    "environment": {
      "pattern": "^[a-z][a-z0-9-]{0,62}$",
      "type": "string"
    },
    "environment_inventory_receipt": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9-]{0,62}$",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "sha256"
      ],
      "type": "object"
    },
    "identities": {
      "additionalProperties": false,
      "properties": {
        "assertions_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "config_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "environment_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "lock_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "package_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "scenario_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "scenario_sha256",
        "assertions_sha256",
        "package_sha256",
        "lock_sha256",
        "config_sha256",
        "environment_sha256"
      ],
      "type": "object"
    },
    "phase": {
      "enum": [
        "baseline",
        "fault",
        "recovery",
        "observation"
      ]
    },
    "profile": {
      "maxLength": 64,
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "type": "string"
    },
    "scenario_id": {
      "pattern": "^[a-z][a-z0-9-]{0,62}$",
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "targets": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "argocd": {
            "additionalProperties": false,
            "properties": {
              "application": {
                "pattern": "^[a-z][a-z0-9-]{0,62}$",
                "type": "string"
              },
              "application_namespace": {
                "pattern": "^[a-z][a-z0-9-]{0,62}$",
                "type": "string"
              },
              "destination": {
                "additionalProperties": false,
                "properties": {
                  "namespace": {
                    "pattern": "^[a-z][a-z0-9-]{0,62}$",
                    "type": "string"
                  },
                  "server": {
                    "maxLength": 2048,
                    "type": "string"
                  }
                },
                "required": [
                  "server",
                  "namespace"
                ],
                "type": "object"
              },
              "destination_spec_sha256": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              },
              "intent_receipt": {
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "pattern": "^[a-z][a-z0-9-]{0,62}$",
                    "type": "string"
                  },
                  "sha256": {
                    "pattern": "^[a-f0-9]{64}$",
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "sha256"
                ],
                "type": "object"
              },
              "project": {
                "pattern": "^[a-z][a-z0-9-]{0,62}$",
                "type": "string"
              },
              "service_id": {
                "const": "argocd"
              },
              "sources": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "intent_receipt": {
                      "additionalProperties": false,
                      "properties": {
                        "id": {
                          "pattern": "^[a-z][a-z0-9-]{0,62}$",
                          "type": "string"
                        },
                        "sha256": {
                          "pattern": "^[a-f0-9]{64}$",
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "sha256"
                      ],
                      "type": "object"
                    },
                    "path": {
                      "maxLength": 1024,
                      "type": "string"
                    },
                    "position": {
                      "maximum": 32,
                      "minimum": 1,
                      "type": "integer"
                    },
                    "rendered_artifact_sha256": {
                      "pattern": "^[a-f0-9]{64}$",
                      "type": "string"
                    },
                    "renderer": {
                      "enum": [
                        "helm",
                        "kustomize",
                        "manifests",
                        "values"
                      ]
                    },
                    "repository_url": {
                      "maxLength": 2048,
                      "type": "string"
                    },
                    "revision": {
                      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$",
                      "type": "string"
                    },
                    "source_spec_sha256": {
                      "pattern": "^[a-f0-9]{64}$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "position",
                    "repository_url",
                    "revision",
                    "path",
                    "renderer"
                  ],
                  "type": "object"
                },
                "maxItems": 32,
                "minItems": 1,
                "type": "array",
                "uniqueItems": true
              }
            },
            "required": [
              "service_id",
              "project",
              "application_namespace",
              "application",
              "sources",
              "destination"
            ],
            "type": "object"
          },
          "id": {
            "pattern": "^[a-z][a-z0-9-]{0,62}$",
            "type": "string"
          },
          "image_mapping_receipt": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "pattern": "^[a-z][a-z0-9-]{0,62}$",
                "type": "string"
              },
              "sha256": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              }
            },
            "required": [
              "id",
              "sha256"
            ],
            "type": "object"
          },
          "kubernetes": {
            "additionalProperties": false,
            "properties": {
              "deployment": {
                "pattern": "^[a-z][a-z0-9-]{0,62}$",
                "type": "string"
              },
              "deployment_uid": {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
                "type": "string"
              },
              "generation": {
                "minimum": 1,
                "type": "integer"
              },
              "namespace": {
                "pattern": "^[a-z][a-z0-9-]{0,62}$",
                "type": "string"
              },
              "service": {
                "pattern": "^[a-z][a-z0-9-]{0,62}$",
                "type": "string"
              },
              "service_id": {
                "const": "kubernetes"
              },
              "service_uid": {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
                "type": "string"
              }
            },
            "required": [
              "service_id",
              "namespace",
              "deployment",
              "service"
            ],
            "type": "object"
          },
          "prometheus": {
            "additionalProperties": false,
            "properties": {
              "instance": {
                "pattern": "^[A-Za-z0-9_.:\\[\\]-]{1,253}$",
                "type": "string"
              },
              "job": {
                "pattern": "^[A-Za-z0-9_.:/-]{1,128}$",
                "type": "string"
              },
              "namespace": {
                "pattern": "^[a-z][a-z0-9-]{0,62}$",
                "type": "string"
              },
              "service": {
                "pattern": "^[a-z][a-z0-9-]{0,62}$",
                "type": "string"
              },
              "service_id": {
                "const": "prometheus"
              }
            },
            "required": [
              "service_id",
              "namespace",
              "service",
              "job",
              "instance"
            ],
            "type": "object"
          },
          "roles": {
            "items": {
              "pattern": "^[a-z][a-z0-9-]{0,62}$",
              "type": "string"
            },
            "maxItems": 8,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "roles",
          "kubernetes",
          "argocd"
        ],
        "type": "object"
      },
      "maxItems": 8,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "attempt_id",
    "phase",
    "environment",
    "profile",
    "scenario_id",
    "identities",
    "targets"
  ],
  "type": "object"
}
