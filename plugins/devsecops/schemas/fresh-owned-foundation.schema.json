      "pattern": "^/home/[A-Za-z0-9_-]+/\\.local/share/devsecops/fresh$"
    },
    "private_state_directory": {
      "type": "string",
      "pattern": "^/[^\\x00-\\x20,]{1,4000}$"
    },
