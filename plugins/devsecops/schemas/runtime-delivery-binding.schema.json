{
  "$id": "urn:devsecops:runtime-delivery-binding:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "type": "string"
    },
    "candidate_tree_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "delivered_at": {
      "format": "date-time",
      "type": "string"
    },
    "delivered_revision": {
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$",
      "type": "string"
    },
    "environment": {
      "pattern": "^[a-z][a-z0-9-]{0,62}$",
      "type": "string"
    },
    "identities": {
      "additionalProperties": false,
      "properties": {
        "assertions_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "config_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "environment_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "lock_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "package_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "scenario_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "scenario_sha256",
        "assertions_sha256",
        "package_sha256",
        "lock_sha256",
        "config_sha256",
        "environment_sha256"
      ],
      "type": "object"
    },
    "kind": {
      "const": "runtime-delivery-binding"
    },
    "native_handoff_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "patch_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "source_position": {
      "maximum": 32,
      "minimum": 1,
      "type": "integer"
    },
    "target_id": {
      "pattern": "^[a-z][a-z0-9-]{0,62}$",
      "type": "string"
    },
    "validation_receipt_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "run_id",
    "attempt_id",
    "environment",
    "identities",
    "target_id",
    "source_position",
    "delivered_revision",
    "delivered_at",
    "native_handoff_sha256",
    "patch_sha256",
    "candidate_tree_sha256",
    "validation_receipt_sha256"
  ],
  "type": "object"
}
