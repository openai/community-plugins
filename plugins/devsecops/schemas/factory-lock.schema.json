{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:devsecops:factory-lock:1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profile": {
      "enum": [
        "bigbang-live",
        "bigbang-disconnected",
        "partybus-hosted",
        "openshift-app",
        "adapter-qualification",
        "replay"
      ]
    },
    "scenario_id": {
      "const": "ironbank-mission-recovery-v1"
    },
    "scenario_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "assertions_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "os": {
          "const": "linux"
        },
        "architecture": {
          "enum": [
            "amd64",
            "arm64"
          ]
        },
        "distribution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "distribution_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "kubernetes_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "bigbang_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "flux_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "argo_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "cni": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "mesh_mode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "os",
        "architecture",
        "distribution",
        "distribution_version",
        "kubernetes_version",
        "bigbang_version",
        "flux_version",
        "argo_version",
        "cni",
        "mesh_mode"
      ]
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "enum": [
              "git",
              "helm",
              "kustomize",
              "kubeconform",
              "kubectl",
              "cosign",
              "syft",
              "grype",
              "codex"
            ]
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "name",
          "version",
          "sha256"
        ]
      },
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reference_web": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "pattern": "^registry1\\.dso\\.mil/ironbank/[a-z0-9._/-]+$"
            },
            "manifest_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "platform_manifest_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "config_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "os": {
              "const": "linux"
            },
            "architecture": {
              "enum": [
                "amd64",
                "arm64"
              ]
            },
            "required_predicates": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "minItems": 1,
              "maxItems": 128,
              "uniqueItems": true
            },
            "trust_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "repository",
            "manifest_sha256",
            "platform_manifest_sha256",
            "config_sha256",
            "os",
            "architecture",
            "required_predicates",
            "trust_sha256"
          ]
        },
        "mission_base": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "pattern": "^registry1\\.dso\\.mil/ironbank/[a-z0-9._/-]+$"
            },
            "manifest_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "platform_manifest_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "config_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "os": {
              "const": "linux"
            },
            "architecture": {
              "enum": [
                "amd64",
                "arm64"
              ]
            },
            "required_predicates": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "minItems": 1,
              "maxItems": 128,
              "uniqueItems": true
            },
            "trust_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "repository",
            "manifest_sha256",
            "platform_manifest_sha256",
            "config_sha256",
            "os",
            "architecture",
            "required_predicates",
            "trust_sha256"
          ]
        }
      },
      "required": [
        "reference_web",
        "mission_base"
      ]
    },
    "freshness_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300
    },
    "observation_window_seconds": {
      "type": "integer",
      "minimum": 2,
      "maximum": 3600
    },
    "scrape_interval_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300
    },
    "required_fresh_scrapes": {
      "type": "integer",
      "minimum": 3,
      "maximum": 20
    }
  },
  "required": [
    "schema_version",
    "profile",
    "scenario_id",
    "scenario_sha256",
    "assertions_sha256",
    "platform",
    "tools",
    "images",
    "freshness_seconds",
    "observation_window_seconds",
    "scrape_interval_seconds",
    "required_fresh_scrapes"
  ]
}
